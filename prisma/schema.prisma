// Prisma schema for The Rounds — see docs/DATA-MODEL.md for the entity/relationship spec.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  admin
  member
}

model User {
  id          String   @id @default(cuid())
  googleSub   String   @unique @map("google_sub")
  email       String   @unique
  displayName  String   @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  hasOnboarded Boolean  @default(false) @map("has_onboarded")
  createdAt    DateTime @default(now()) @map("created_at")

  notes            Note[]
  subjects         Subject[]
  createdGroups    Group[]           @relation("GroupCreator")
  groupMemberships GroupMembership[]

  @@map("users")
}

model Note {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId    String   @map("folder_id")
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  focus       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shares NoteShare[]

  @@index([ownerId])
  @@index([folderId])
  @@map("notes")
}

// The course/rotation, e.g. "Pharmacology" — top-level, owner-scoped, free-form
// and implicitly created just like Topic/Folder used to be.
model Subject {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  topics Topic[]

  @@unique([ownerId, name])
  @@map("subjects")
}

// A specific subtopic within a Subject, e.g. "Antibiotics" within "Pharmacology".
model Topic {
  id        String   @id @default(cuid())
  subjectId String   @map("subject_id")
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  folders Folder[]

  @@unique([subjectId, name])
  @@map("topics")
}

// The exam-period bucket within a Topic — Prelims/Midterms/Finals are
// auto-created as defaults whenever a Topic is first created, but the name
// is free-form/student-editable and extra folders can be added too.
model Folder {
  id        String   @id @default(cuid())
  topicId   String   @map("topic_id")
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  notes Note[]

  @@unique([topicId, name])
  @@map("folders")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdBy String   @map("created_by")
  creator   User     @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  memberships GroupMembership[]
  noteShares  NoteShare[]

  @@map("groups")
}

model GroupMembership {
  id       String    @id @default(cuid())
  groupId  String    @map("group_id")
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String    @map("user_id")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at")

  @@unique([groupId, userId])
  @@map("group_memberships")
}

model NoteShare {
  id       String   @id @default(cuid())
  noteId   String   @map("note_id")
  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  groupId  String   @map("group_id")
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sharedAt DateTime @default(now()) @map("shared_at")

  @@unique([noteId, groupId])
  @@map("note_shares")
}
